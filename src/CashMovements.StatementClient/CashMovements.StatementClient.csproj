    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="all" />
    <Protobuf Include="../CashMovements.Grpc/Protos/cashmovements/v1/cash_movements.proto"
              Link="Protos/cashmovements/v1/cash_movements.proto"
              ProtoRoot="../CashMovements.Grpc/Protos" GrpcServices="Client" Access="Internal" />
